# Client : client cifs du noyau (montage par défaut, comme Manjaro), Python 3.12 et les dépendances de Coupole.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends cifs-utils sqlite3 libegl1 libgl1 libxkbcommon-x11-0 \
        libdbus-1-3 libfontconfig1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install -q numpy astropy scipy zstandard lz4 PyQt6 pytest lxml xisf psutil pillow sep
